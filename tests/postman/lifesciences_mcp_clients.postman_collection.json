                },
                {
                  "key": "pageSize",
                  "value": "{{page_size}}"
                },
                {
                  "key": "countTotal",
                  "value": "true"
                },
                {
                  "key": "format",
                  "value": "json"
                },
                {
                  "key": "fields",
                  "value": "NCTId,BriefTitle,BriefSummary,Phase,OverallStatus,Condition,InterventionName"
                },
                {
                  "key": "pageToken",
                  "value": "{{page_token}}"
                },
                {
                  "key": "filter.overallStatus",
                  "value": "{{status}}"
                },
                {
                  "key": "filter.advanced",
