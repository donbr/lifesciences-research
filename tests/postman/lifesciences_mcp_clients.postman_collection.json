  "item": [
    {
      "name": "BioGRID",
      "item": [
        {
          "name": "search_genes",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{biogrid_base_url}}/interactions/?geneList={{query}}&taxId={{organism}}&searchNames=true&format=count&accesskey={{biogrid_api_key}}",
              "host": [
                "{{biogrid_base_url}}"
              ],
              "path": [
                "interactions",
                ""
              ],
              "query": [
                {
                  "key": "geneList",
                  "value": "{{query}}",
                  "description": "Gene symbol to search (e.g. BRCA1). Normalized to uppercase."
                },
                {
                  "key": "taxId",
                  "value": "{{organism}}",
                  "description": "NCBI Taxonomy ID (default: 9606 for Homo sapiens)"
                },
                {
                  "key": "searchNames",
                  "value": "true",
                  "description": "Match gene names and synonyms"
                },
                {
                  "key": "format",
                  "value": "count",
                  "description": "Returns single integer count (lightweight existence check)"
                },
                {
                  "key": "accesskey",
                  "value": "{{biogrid_api_key}}"
                }
              ]
            },
            "description": "Maps to BioGridClient.search_genes in biogrid.py. API-BACKED SEARCH — queries BioGRID /interactions with format=count for lightweight gene existence verification (~200ms). Returns interaction count; count=0 triggers ENTITY_NOT_FOUND. Client-side regex serves as fail-fast guard only. Parameters: query (gene symbol), organism (NCBI taxon ID, default 9606)."
          }
        },
        {
          "name": "get_interactions",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{biogrid_base_url}}/interactions/?geneList={{gene_symbol}}&taxId={{tax_id}}&includeInterspecies={{include_interspecies}}&format=json&accesskey={{biogrid_api_key}}",
              "host": [
                "{{biogrid_base_url}}"
              ],
              "path": [
                "interactions",
                ""
              ],
              "query": [
                {
                  "key": "geneList",
                  "value": "{{gene_symbol}}"
                },
                {
                  "key": "taxId",
                  "value": "{{tax_id}}"
                },
                {
                  "key": "includeInterspecies",
                  "value": "{{include_interspecies}}"
                },
                {
                  "key": "format",
                  "value": "json"
                },
                {
                  "key": "accesskey",
                  "value": "{{biogrid_api_key}}"
                }
              ]
            },
            "description": "Maps to BioGridClient.get_interactions in biogrid.py. Returns full interaction records by default. Client-side slim=True parameter reduces response to symbol_b + experimental_system_type per interaction (~15 tokens vs ~100 full). slim is a client-side parameter and does not change the BioGRID API request."
          }
        }
      ]
    },
