                {
                  "key": "query.locn",
                  "value": "{{location}}"
                }
              ]
            },
            "description": "Maps to ClinicalTrialsClient.search_trials in clinicaltrials.py. filter.overallStatus and filter.advanced are critical params fixed in AGE-132. Remove unused filter params before sending (Postman will send empty values otherwise)."
          }
